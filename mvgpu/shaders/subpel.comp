// Sub-pixel refinement of the final block vectors, which the search leaves in
// whole pixels of motion A -> C (m = 2u, search.comp): u moves +-1/4 px (motion
// in 1/2 px steps) where that matches the block better, and becomes a float
// half-vector for select.comp. Bilinear sampling smooths noise a little, which
// alone lowers the SAD between pixels, so a fractional position must beat the
// whole one clearly. One invocation per pixel: a group holds one 8x8 block or
// four 4x4 blocks, and sums each candidate's SAD in shared memory. A block that
// already matches (SAD under the bias every candidate pays) skips the search.
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer PyrA { float pa[]; };
layout(std430, binding = 1) readonly buffer PyrC { float pc[]; };
layout(std430, binding = 2) readonly buffer Vin { ivec2 vin[]; };  // motion m = 2u (search.comp)
layout(std430, binding = 3) writeonly buffer Vout { vec2 vout[]; };
layout(push_constant) uniform P { uint off; int w, h, bw, bh, bs, steps; float gdc; } p;  // gdc: mean A - C (search.comp)
shared float sad[9][64];
shared vec2 su[4];
shared bool sdone[4];
float bil_a(vec2 q) {
    q = clamp(q, vec2(0.0), vec2(p.w - 1.001, p.h - 1.001));
    ivec2 i = ivec2(q); vec2 f = q - vec2(i);
    uint r0 = p.off + uint(i.y * p.w + i.x), r1 = r0 + uint(p.w);
    return mix(mix(pa[r0], pa[r0 + 1u], f.x), mix(pa[r1], pa[r1 + 1u], f.x), f.y);
}
float bil_c(vec2 q) {
    q = clamp(q, vec2(0.0), vec2(p.w - 1.001, p.h - 1.001));
    ivec2 i = ivec2(q); vec2 f = q - vec2(i);
    uint r0 = p.off + uint(i.y * p.w + i.x), r1 = r0 + uint(p.w);
    return mix(mix(pc[r0], pc[r0 + 1u], f.x), mix(pc[r1], pc[r1 + 1u], f.x), f.y);
}
// sums sad[0..k) over each block's n = bs*bs invocations into its first one
void reduce(uint t, uint n, int k) {
    for (uint s = n >> 1; s > 0u; s >>= 1) {
        if ((t & (n - 1u)) < s)
            for (int c = 0; c < k; ++c) sad[c][t] += sad[c][t + s];
        barrier();
    }
}
void main() {
    uint t = gl_LocalInvocationID.x, n = uint(p.bs * p.bs), k = t / n, lead = k * n;
    uint g = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;  // 2D: past 65535 groups
    int b = int(g * (64u / n) + k);
    bool live = b < p.bw * p.bh;
    int pix = int(t - lead);
    ivec2 o = live ? ivec2(b % p.bw, b / p.bw) * p.bs + ivec2(pix % p.bs, pix / p.bs) : ivec2(0);
    vec2 q = vec2(o);
    vec2 u0 = live ? 0.5 * vec2(vin[b]) : vec2(0.0);
    sad[0][t] = live ? abs(bil_a(q - u0) - bil_c(q + u0) - p.gdc) : 0.0;
    barrier();
    reduce(t, n, 1);
    float bias = 1e-4 * float(n);
    if (t == lead) { su[k] = u0; sdone[k] = !live || sad[0][t] <= bias || p.steps == 0; }
    float best = sad[0][lead];  // read before the next writes to sad[0]
    barrier();
    float step = 0.25;
    for (int s = 0; s < p.steps; ++s, step *= 0.5) {
        vec2 c = su[k];
        bool skip = sdone[k];  // the whole block agrees
        if (!skip)
            for (int j = 0; j < 9; ++j) {
                vec2 v = c + step * vec2(j % 3 - 1, j / 3 - 1);
                sad[j][t] = live && j != 4 ? abs(bil_a(q - v) - bil_c(q + v) - p.gdc) : 0.0;
            }
        barrier();
        reduce(t, n, 9);
        if (t == lead && !skip) {
            for (int j = 0; j < 9; ++j) {
                if (j == 4) continue;
                float e = sad[j][t] * 1.02 + bias;
                if (e < best) { best = e; su[k] = c + step * vec2(j % 3 - 1, j / 3 - 1); }
            }
        }
        barrier();
    }
    if (t == lead && live) vout[b] = su[k];
}

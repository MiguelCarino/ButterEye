+// ButterEye: the GPU instance now outlives the filters (see plugin.cpp), and so
+// do the device's pooled blob/staging allocators that process() borrows, each
+// keeping every frame-sized buffer it ever held (about 0.45 GiB at 720p, 3.7 GiB
+// at 2160p). Track how many are borrowed at once so release_idle_buffers() can
+// borrow back every one of them and free that memory.
+static std::atomic<int> allocators_out{ 0 };
+static std::atomic<int> allocators_peak{ 0 };
+
+static void count_allocators_out()
+{
+    const int out = ++allocators_out;
+    int peak = allocators_peak;
+    while (out > peak && !allocators_peak.compare_exchange_weak(peak, out))
+        ;
+}
+
+void RIFE::release_idle_buffers() const
+{
+    host_pool.clear();
+
+    if (!vkdev)
+        return;
+
+    // with nothing in flight every pooled allocator is free; ncnn pre-creates one
+    // per compute queue and adds one whenever all are out, so borrowing the larger
+    // of the two counts returns each of them
+    const int queues = vkdev->info.compute_queue_count();
+    const int n = allocators_peak > queues ? allocators_peak.load() : queues;
+    std::vector<ncnn::VkAllocator*> blob(n), staging(n);
+    for (int i = 0; i < n; i++)
+    {
+        blob[i] = vkdev->acquire_blob_allocator();
+        staging[i] = vkdev->acquire_staging_allocator();
+    }
+    for (int i = 0; i < n; i++)
+    {
+        blob[i]->clear();
+        staging[i]->clear();
+        vkdev->reclaim_blob_allocator(blob[i]);
+        vkdev->reclaim_staging_allocator(staging[i]);
+    }
+}
+
